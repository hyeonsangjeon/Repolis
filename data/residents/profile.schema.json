{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyeonsangjeon.github.io/Repolis/data/residents/profile.schema.json",
  "title": "Repolis resident profile",
  "type": "object",
  "required": [
    "schema",
    "version",
    "generated_at",
    "repo",
    "age",
    "job",
    "personality",
    "recent_concerns",
    "bound_memories",
    "shared",
    "archived",
    "dialogue_available",
    "provenance"
  ],
  "properties": {
    "schema": { "const": "repolis.resident-profile" },
    "version": { "const": 1 },
    "generated_at": { "type": "string" },
    "repo": { "type": "object" },
    "age": { "type": "object" },
    "job": { "type": "object" },
    "personality": { "type": "object" },
    "recent_concerns": { "type": "array", "maxItems": 3 },
    "bound_memories": { "type": "array", "maxItems": 4 },
    "shared": { "type": "object" },
    "archived": { "type": "boolean" },
    "dialogue_available": { "type": "boolean" },
    "provenance": { "type": "object" }
  },
  "additionalProperties": false
}
