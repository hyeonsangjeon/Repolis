{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyeonsangjeon.github.io/Repolis/data/residents/manifest.schema.json",
  "title": "Repolis resident manifest",
  "type": "object",
  "required": [
    "schema",
    "version",
    "generated_at",
    "owner",
    "profile_schema",
    "profile_version",
    "profile_count",
    "active_count",
    "registry_digest",
    "profiles",
    "active_roster"
  ],
  "properties": {
    "schema": { "const": "repolis.resident-manifest" },
    "version": { "const": 1 },
    "generated_at": { "type": "string" },
    "owner": { "type": "string" },
    "profile_schema": { "const": "repolis.resident-profile" },
    "profile_version": { "const": 1 },
    "profile_count": { "type": "integer", "minimum": 0 },
    "active_count": { "type": "integer", "minimum": 0, "maximum": 9 },
    "registry_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo", "slug", "path", "digest", "authority_digest", "archived", "dialogue_available"]
      }
    },
    "active_roster": {
      "type": "array",
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["resident_id", "repo", "slug", "path", "profile_digest", "authority_digest"]
      }
    }
  },
  "additionalProperties": false
}
